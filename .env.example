# Lab Manual Conversational AI Assistant Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///db/lab_manuals.db

# LLM Configurations
# Set your OpenAI API key or Gemini API key.
# If left empty, the system automatically uses the Grounded Synthesis Engine (no API key required).
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto

# Vector Store Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# File Upload Limit
MAX_FILE_SIZE_MB=50
